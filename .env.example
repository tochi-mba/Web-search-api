# ---------------------------------------------------------------------------
# web-search-api configuration.
#
# There are NO provider API keys here. Every third-party credential lives in
# keyring and is resolved per request, for the person the request is being made
# for. See docs/keyring.md.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
WSA_LOG_LEVEL=INFO
WSA_JSON_LOGS=true
# Optional front-door gate. The keyring user token is the real identity;
# this is a network-level control on top of it.
WSA_API_KEYS=

# --- Keyring ---------------------------------------------------------------
# Where the vault lives, and this service's own token, which keyring must be
# configured to recognise:
#     KEYRING_SERVICE_TOKENS='{"web-search-api":"<same token, 32+ characters>"}'
# Leave both empty to run with only local model runtimes, which need no
# credential at all.
WSA_KEYRING_BASE_URL=http://127.0.0.1:8001
WSA_KEYRING_SERVICE_TOKEN=
# Must match the audience callers mint their tokens for:
#     POST /v1/auth/service-token {"audience": "web-search-api"}
WSA_KEYRING_SERVICE_NAME=web-search-api
WSA_KEYRING_ISSUER=http://127.0.0.1:8001
# Used when a request sends no X-Keyring-Profile header.
WSA_KEYRING_DEFAULT_PROFILE=personal
WSA_KEYRING_TIMEOUT_SECONDS=10
WSA_JWKS_CACHE_SECONDS=3600
WSA_JWKS_MIN_REFETCH_SECONDS=60
WSA_JWKS_STALE_GRACE_SECONDS=86400

# --- LLM defaults ----------------------------------------------------------
WSA_DEFAULT_MODEL=anthropic:claude-opus-5
WSA_MODEL_CACHE_TTL_SECONDS=300
WSA_PROVIDER_PROBE_TIMEOUT_SECONDS=5
WSA_MAX_CONTENT_CHARS=40000

# --- Fetching --------------------------------------------------------------
WSA_REQUEST_TIMEOUT_SECONDS=20
WSA_RESPECT_ROBOTS=true
WSA_ALLOW_PRIVATE_NETWORKS=false
WSA_MAX_CONCURRENCY=8

# --- Background jobs -------------------------------------------------------
# Jobs are held in memory, so they are lost on restart and are not shared
# between replicas.
WSA_MAX_BACKGROUND_JOBS=4
WSA_JOB_RETENTION_SECONDS=3600
WSA_MAX_STORED_JOBS=1000

# --- Search ----------------------------------------------------------------
WSA_SEARCH_BACKEND=google
# A URL, not a secret. The Serper API key lives in keyring under "serper".
WSA_SEARXNG_BASE_URL=
WSA_BROWSER_HEADLESS=true

# --- Per-person settings (settings-api) -----------------------------------
# Unset (the default) keeps today's behaviour: everybody on this box shares
# the knobs above. Set both to read each person's `search` settings instead.
# The token is this service's entry in settings-api; its grant there needs
# audience_prefix `web-search-api`. Never log it.
# WSA_SETTINGS_API_BASE_URL=http://127.0.0.1:8003
# WSA_SETTINGS_API_TOKEN=

# --- Local model runtimes --------------------------------------------------
# These need no credential, so they work without keyring entirely.
WSA_PROVIDER_BASE_URLS='{"ollama":"http://localhost:11434","lmstudio":"","vllm":""}'
