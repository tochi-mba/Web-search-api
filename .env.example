# ---------------------------------------------------------------------------
# web-search-api configuration. Every value below is optional.
# Copy to .env and fill in only what you need.
# ---------------------------------------------------------------------------

# --- Service ---------------------------------------------------------------
WSA_LOG_LEVEL=INFO
WSA_JSON_LOGS=true
# Comma-separated. Leave empty to run the API unauthenticated.
WSA_API_KEYS=

# --- LLM defaults ----------------------------------------------------------
WSA_DEFAULT_MODEL=anthropic:claude-opus-5
WSA_MODEL_CACHE_TTL_SECONDS=300
WSA_PROVIDER_PROBE_TIMEOUT_SECONDS=5
WSA_MAX_CONTENT_CHARS=40000

# --- Fetching --------------------------------------------------------------
WSA_REQUEST_TIMEOUT_SECONDS=20
WSA_RESPECT_ROBOTS=true
WSA_ALLOW_PRIVATE_NETWORKS=false
WSA_MAX_CONCURRENCY=8
WSA_MAX_CONCURRENCY_PER_HOST=2

# --- Search ----------------------------------------------------------------
WSA_SEARCH_BACKEND=google
WSA_SEARXNG_BASE_URL=
WSA_SERPER_API_KEY=
WSA_BROWSER_HEADLESS=true

# ---------------------------------------------------------------------------
# Provider credentials. Any provider whose key is absent, wrong, or whose
# endpoint is unreachable is simply omitted from GET /v1/models.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
# Local runtimes need no key, only a reachable base URL.
OLLAMA_BASE_URL=http://localhost:11434
